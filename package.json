{
  "name": "backend-challenge",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "migration:create": "bun ./node_modules/@mikro-orm/cli/cli.js migration:create --config ./src/infrastructure/database/mikro-orm/mikro-orm.config.ts",
    "migration:up": "bun ./node_modules/@mikro-orm/cli/cli.js migration:up --config ./src/infrastructure/database/mikro-orm/mikro-orm.config.ts",
    "migration:down": "bun ./node_modules/@mikro-orm/cli/cli.js migration:down --config ./src/infrastructure/database/mikro-orm/mikro-orm.config.ts",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:concurrency": "bun test ./test/e2e/concurrency.e2e-spec.ts",
    "test:e2e": "bun test ./test/e2e/sqs-localstack.e2e-spec.ts ./test/e2e/concurrency.e2e-spec.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
